{
  "name": "pi-zellij-tab-status",
  "version": "0.7.3",
  "type": "module",
  "description": "Publish PI activity and unseen completion to the Zellij vertical sidebar.",
  "exports": {
    ".": "./pi-extension.ts",
    "./pi-extension": "./pi-extension.ts"
  },
  "files": [
    "CHANGELOG.md",
    "pi-extension.ts",
    "lib"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "lint": "eslint . --max-warnings 0",
    "test:tooling": "tsx scripts/check-tooling.ts",
    "check": "npm run typecheck && npm run lint && npm run test:tooling && npm test",
    "test": "node --import tsx --test test/*.test.ts",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 --test-coverage-include='lib/*.ts' --test-coverage-include=pi-extension.ts test/*.test.ts",
    "test:smoke": "python e2e/run.py LiveTabStatus.test_parent_status_uses_pipe_without_mutating_the_title",
    "test:e2e": "python -m unittest discover -s e2e -p 'test_*.py' && python e2e/run.py",
    "eval": "python evals/tab-status/run.py"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-tui": "1.5.0",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "jiti": "2.7.0",
    "tsx": "4.23.15",
    "typebox": "1.3.27",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0"
  },
  "overrides": {
    "undici@8.10.2": "8.12.2",
    "minimatch@>=7 <11.0.1": "11.0.1"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/pbjorklund/pi-zellij-tab-status.git"
  },
  "bugs": {
    "url": "https://github.com/pbjorklund/pi-zellij-tab-status/issues"
  },
  "homepage": "https://github.com/pbjorklund/pi-zellij-tab-status#readme",
  "pi": {
    "extensions": [
      "./pi-extension.ts"
    ]
  }
}
